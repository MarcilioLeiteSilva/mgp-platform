datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==============================================================================
// 1. Identidade, Multi-Tenancy e Permissões (RBAC)
// ==============================================================================

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  ANALYST
  DEVELOPER
  PUBLISHER
  ADVERTISER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model User {
  id              String                   @id @default(uuid())
  email           String                   @unique
  fullName        String                   @map("full_name")
  passwordHash    String                   @map("password_hash")
  isActive        Boolean                  @default(true) @map("is_active")
  isSuperadmin    Boolean                  @default(false) @map("is_superadmin")
  memberships     Membership[]
  sessions        Session[]
  sentInvitations OrganizationInvitation[] @relation("InvitationsSent")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  @@map("users")
}

model Organization {
  id              String                   @id @default(uuid())
  name            String
  slug            String                   @unique
  documentCnpjCpf String?                  @map("document_cnpj_cpf")
  planTier        String                   @default("FREE") @map("plan_tier")
  isVerified      Boolean                  @default(false) @map("is_verified")
  memberships     Membership[]
  invitations     OrganizationInvitation[]
  apps            App[]
  campaigns       Campaign[]
  wallet          Wallet?
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  @@map("organizations")
}

model Membership {
  id             String       @id @default(uuid())
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           UserRole     @default(DEVELOPER)
  isDefault      Boolean      @default(false) @map("is_default")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([userId, organizationId])
  @@map("memberships")
}

model Session {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String    @unique @map("refresh_token")
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address")
  isRevoked    Boolean   @default(false) @map("is_revoked")
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([userId, isRevoked])
  @@map("sessions")
}

model OrganizationInvitation {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           UserRole         @default(DEVELOPER)
  token          String           @unique
  invitedById    String           @map("invited_by_id")
  invitedBy      User             @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: Cascade)
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime         @map("expires_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@index([organizationId, status])
  @@index([email, status])
  @@map("organization_invitations")
}

// ==============================================================================
// 2. Catálogo de Aplicativos e Espaços Publicitários
// ==============================================================================

enum AppPlatform {
  ANDROID
  IOS
}

enum AppStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum AdFormat {
  BANNER
  NATIVE
  INTERSTITIAL
  REWARDED
}

model App {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  packageName    String        @map("package_name")
  platform       AppPlatform   @default(ANDROID)
  status         AppStatus     @default(PENDING)
  sdkKey         String        @unique @default(uuid()) @map("sdk_key")
  adUnits        AdUnit[]
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@unique([organizationId, packageName, platform])
  @@map("apps")
}

model AdUnit {
  id        String   @id @default(uuid())
  appId     String   @map("app_id")
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  name      String
  format    AdFormat
  placement String?
  floorEcpm Decimal  @default(0.0) @db.Decimal(10, 4) @map("floor_ecpm")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ad_units")
}

// ==============================================================================
// 3. Campanhas Publicitárias e Criativos
// ==============================================================================

enum CampaignType {
  HOUSE_AD
  EXCHANGE
  PAID
}

enum CampaignBillingModel {
  CPM
  CPC
  CPI
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  SUSPENDED
}

model Campaign {
  id             String               @id @default(uuid())
  organizationId String               @map("organization_id")
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  type           CampaignType         @default(PAID)
  billingModel   CampaignBillingModel @default(CPM) @map("billing_model")
  bidAmount      Decimal              @db.Decimal(10, 4) @map("bid_amount")
  dailyBudget    Decimal              @db.Decimal(10, 4) @map("daily_budget")
  totalBudget    Decimal              @db.Decimal(10, 4) @map("total_budget")
  status         CampaignStatus       @default(DRAFT)
  targetCountry  String               @default("BR") @map("target_country")
  creatives      Creative[]
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@index([organizationId, status])
  @@map("campaigns")
}

model Creative {
  id          String   @id @default(uuid())
  campaignId  String   @map("campaign_id")
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  format      AdFormat
  title       String
  description String?
  imageUrl    String   @map("image_url")
  actionUrl   String   @map("action_url")
  width       Int      @default(320)
  height      Int      @default(50)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("creatives")
}

// ==============================================================================
// 4. Razão Contábil Imutável (Financial Ledger) e Carteira
// ==============================================================================

enum WalletAccountType {
  ADVERTISING_CREDITS
  EXCHANGE_CREDITS
  PUBLISHER_EARNINGS
}

enum LedgerTransactionType {
  DEPOSIT_FIAT
  EXCHANGE_EARNED
  EXCHANGE_CONSUMED
  CAMPAIGN_SPEND
  PUBLISHER_CREDIT
  PAYOUT_WITHDRAWAL
  FRAUD_CHARGEBACK
  SYSTEM_ADJUSTMENT
}

model Wallet {
  id             String          @id @default(uuid())
  organizationId String          @unique @map("organization_id")
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accounts       WalletAccount[]
  createdAt      DateTime        @default(now()) @map("created_at")

  @@map("wallets")
}

model WalletAccount {
  id            String            @id @default(uuid())
  walletId      String            @map("wallet_id")
  wallet        Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type          WalletAccountType
  currency      String            @default("BRL")
  cachedBalance Decimal           @default(0.0) @db.Decimal(14, 4) @map("cached_balance")
  ledgerEntries WalletLedger[]

  @@unique([walletId, type])
  @@map("wallet_accounts")
}

model WalletLedger {
  id              String                @id @default(uuid())
  accountId       String                @map("account_id")
  account         WalletAccount         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  transactionType LedgerTransactionType @map("transaction_type")
  amount          Decimal               @db.Decimal(14, 4)
  balanceAfter    Decimal               @db.Decimal(14, 4) @map("balance_after")
  referenceId     String?               @map("reference_id")
  idempotencyKey  String                @unique @map("idempotency_key")
  description     String
  metadata        Json?
  createdAt       DateTime              @default(now()) @map("created_at")

  @@index([accountId, createdAt])
  @@map("wallet_ledger")
}

// ==============================================================================
// 5. Auditoria Centralizada
// ==============================================================================

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  userId         String?  @map("user_id")
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  diffBefore     Json?    @map("diff_before")
  diffAfter      Json?    @map("diff_after")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}


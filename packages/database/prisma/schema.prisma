datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==============================================================================
// 1. Identidade, Multi-Tenancy e Permissões (RBAC)
// ==============================================================================

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  ANALYST
  DEVELOPER
  PUBLISHER
  ADVERTISER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model User {
  id              String                   @id @default(uuid())
  email           String                   @unique
  fullName        String                   @map("full_name")
  passwordHash    String                   @map("password_hash")
  isActive        Boolean                  @default(true) @map("is_active")
  isSuperadmin    Boolean                  @default(false) @map("is_superadmin")
  memberships     Membership[]
  sessions        Session[]
  sentInvitations OrganizationInvitation[] @relation("InvitationsSent")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  @@map("users")
}

model Organization {
  id                String                   @id @default(uuid())
  name              String
  slug              String                   @unique
  documentCnpjCpf   String?                  @map("document_cnpj_cpf")
  planTier          String                   @default("FREE") @map("plan_tier")
  isVerified        Boolean                  @default(false) @map("is_verified")
  memberships       Membership[]
  invitations       OrganizationInvitation[]
  apps              App[]
  campaigns         Campaign[]
  wallet            Wallet?
  asoApps           AsoApp[]
  asoAppEstimates   AsoAppEstimate[]
  trendAlerts       AsoTrendAlert[]
  aiRecommendations AsoAiRecommendation[]
  telemetrySessions TelemetrySession[]
  payoutRequests    PayoutRequest[]
  depositInvoices   DepositInvoice[]
  fraudIncidents    FraudIncident[]
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  @@map("organizations")
}

model Membership {
  id             String       @id @default(uuid())
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           UserRole     @default(DEVELOPER)
  isDefault      Boolean      @default(false) @map("is_default")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([userId, organizationId])
  @@map("memberships")
}

model Session {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique @map("refresh_token")
  userAgent    String?  @map("user_agent")
  ipAddress    String?  @map("ip_address")
  isRevoked    Boolean  @default(false) @map("is_revoked")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, isRevoked])
  @@map("sessions")
}

model OrganizationInvitation {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           UserRole         @default(DEVELOPER)
  token          String           @unique
  invitedById    String           @map("invited_by_id")
  invitedBy      User             @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: Cascade)
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime         @map("expires_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@index([organizationId, status])
  @@index([email, status])
  @@map("organization_invitations")
}

// ==============================================================================
// 2. Catálogo de Aplicativos e Espaços Publicitários
// ==============================================================================

enum AppPlatform {
  ANDROID
  IOS
}

enum AppStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum AdFormat {
  BANNER
  NATIVE
  INTERSTITIAL
  REWARDED
}

model App {
  id                String                 @id @default(uuid())
  organizationId    String                 @map("organization_id")
  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  packageName       String                 @map("package_name")
  platform          AppPlatform            @default(ANDROID)
  status            AppStatus              @default(PENDING)
  sdkKey            String                 @unique @default(uuid()) @map("sdk_key")
  adUnits           AdUnit[]
  telemetrySessions TelemetrySession[]
  telemetryEvents   TelemetryEventRecord[]
  fraudIncidents    FraudIncident[]
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  @@unique([organizationId, packageName, platform])
  @@map("apps")
}

model AdUnit {
  id        String   @id @default(uuid())
  appId     String   @map("app_id")
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  name      String
  format    AdFormat
  placement String?
  floorEcpm Decimal  @default(0.0) @map("floor_ecpm") @db.Decimal(10, 4)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ad_units")
}

// ==============================================================================
// 3. Campanhas Publicitárias e Criativos
// ==============================================================================

enum CampaignType {
  HOUSE_AD
  EXCHANGE
  PAID
}

enum CampaignBillingModel {
  CPM
  CPC
  CPI
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  SUSPENDED
}

enum BiddingStrategy {
  MANUAL
  TARGET_CPA
  MAX_CLICKS
  MAX_IMPRESSIONS
  SMART_PACING
}

enum PacingMode {
  ACCELERATED
  EVEN
  SMART_DYNAMIC
}

enum RecommendationType {
  BID_ADJUSTMENT
  PACING_OPTIMIZATION
  BUDGET_SCALING
  CREATIVE_FATIGUE
  AUDIENCE_EXPANSION
}

enum RecommendationStatus {
  PENDING
  APPLIED
  DISMISSED
}

enum RecommendationPriority {
  HIGH
  MEDIUM
  LOW
}

model Campaign {
  id                  String                   @id @default(uuid())
  organizationId      String                   @map("organization_id")
  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                String
  type                CampaignType             @default(PAID)
  billingModel        CampaignBillingModel     @default(CPM) @map("billing_model")
  bidAmount           Decimal                  @map("bid_amount") @db.Decimal(10, 4)
  dailyBudget         Decimal                  @map("daily_budget") @db.Decimal(10, 4)
  totalBudget         Decimal                  @map("total_budget") @db.Decimal(10, 4)
  spentAmount         Decimal                  @default(0.0) @map("spent_amount") @db.Decimal(10, 4)
  frequencyCapPerHour Int?                     @default(3) @map("frequency_cap_per_hour")
  priorityTier        Int?                     @default(2) @map("priority_tier")
  status              CampaignStatus           @default(DRAFT)
  biddingStrategy     BiddingStrategy          @default(MANUAL) @map("bidding_strategy")
  pacingMode          PacingMode               @default(EVEN) @map("pacing_mode")
  targetCpa           Decimal?                 @map("target_cpa") @db.Decimal(10, 4)
  autoOptimize        Boolean                  @default(false) @map("auto_optimize")
  targetCountry       String                   @default("BR") @map("target_country")
  targetCategories    String?                  @default("ALL") @map("target_categories")
  startDate           DateTime?                @map("start_date")
  endDate             DateTime?                @map("end_date")
  creatives           Creative[]
  recommendations     CampaignRecommendation[]
  fraudIncidents      FraudIncident[]
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  @@index([organizationId, status])
  @@map("campaigns")
}

model Creative {
  id                   String   @id @default(uuid())
  campaignId           String   @map("campaign_id")
  campaign             Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  format               AdFormat
  title                String
  description          String?
  imageUrl             String   @map("image_url")
  actionUrl            String   @map("action_url")
  width                Int      @default(320)
  height               Int      @default(50)
  iconUrl              String?  @map("icon_url")
  ctaText              String?  @default("Instalar") @map("cta_text")
  starRating           Decimal? @map("star_rating") @db.Decimal(3, 2)
  sponsorText          String?  @map("sponsor_text")
  skipOffsetSeconds    Int?     @default(5) @map("skip_offset_seconds")
  rewardType           String?  @map("reward_type")
  rewardAmount         Int?     @map("reward_amount")
  requiredWatchSeconds Int?     @default(15) @map("required_watch_seconds")
  htmlContent          String?  @map("html_content")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("creatives")
}

model CampaignRecommendation {
  id              String                 @id @default(uuid())
  campaignId      String                 @map("campaign_id")
  campaign        Campaign               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  organizationId  String                 @map("organization_id")
  type            RecommendationType
  priority        RecommendationPriority @default(MEDIUM)
  title           String
  message         String
  suggestedAction String                 @map("suggested_action")
  expectedImpact  String                 @map("expected_impact")
  actionPayload   Json                   @map("action_payload")
  status          RecommendationStatus   @default(PENDING)
  appliedAt       DateTime?              @map("applied_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  @@index([organizationId, status])
  @@index([campaignId, status])
  @@map("campaign_recommendations")
}

// ==============================================================================
// 4. Razão Contábil Imutável (Financial Ledger) e Carteira
// ==============================================================================

enum WalletAccountType {
  ADVERTISING_CREDITS
  EXCHANGE_CREDITS
  PUBLISHER_EARNINGS
}

enum LedgerTransactionType {
  DEPOSIT_FIAT
  EXCHANGE_EARNED
  EXCHANGE_CONSUMED
  CAMPAIGN_SPEND
  PUBLISHER_CREDIT
  PAYOUT_WITHDRAWAL
  FRAUD_CHARGEBACK
  SYSTEM_ADJUSTMENT
}

model Wallet {
  id             String          @id @default(uuid())
  organizationId String          @unique @map("organization_id")
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accounts       WalletAccount[]
  createdAt      DateTime        @default(now()) @map("created_at")

  @@map("wallets")
}

model WalletAccount {
  id              String            @id @default(uuid())
  walletId        String            @map("wallet_id")
  wallet          Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type            WalletAccountType
  currency        String            @default("BRL")
  cachedBalance   Decimal           @default(0.0) @map("cached_balance") @db.Decimal(14, 4)
  ledgerEntries   WalletLedger[]
  payoutRequests  PayoutRequest[]
  depositInvoices DepositInvoice[]

  @@unique([walletId, type])
  @@map("wallet_accounts")
}

model WalletLedger {
  id              String                @id @default(uuid())
  accountId       String                @map("account_id")
  account         WalletAccount         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  transactionType LedgerTransactionType @map("transaction_type")
  amount          Decimal               @db.Decimal(14, 4)
  balanceAfter    Decimal               @map("balance_after") @db.Decimal(14, 4)
  referenceId     String?               @map("reference_id")
  idempotencyKey  String                @unique @map("idempotency_key")
  description     String
  metadata        Json?
  createdAt       DateTime              @default(now()) @map("created_at")

  @@index([accountId, createdAt])
  @@map("wallet_ledger")
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
}

enum PayoutMethod {
  PIX
  BANK_TRANSFER
  STRIPE_CONNECT
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  BOLETO
}

model PayoutRequest {
  id              String        @id @default(uuid())
  organizationId  String        @map("organization_id")
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  walletAccountId String        @map("wallet_account_id")
  walletAccount   WalletAccount @relation(fields: [walletAccountId], references: [id], onDelete: Restrict)
  amount          Decimal       @db.Decimal(14, 4)
  currency        String        @default("BRL")
  status          PayoutStatus  @default(PENDING)
  payoutMethod    PayoutMethod  @default(PIX) @map("payout_method")
  recipientKey    String        @map("recipient_key")
  recipientData   Json?         @map("recipient_data")
  processedAt     DateTime?     @map("processed_at")
  failureReason   String?       @map("failure_reason")
  idempotencyKey  String        @unique @map("idempotency_key")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([organizationId, createdAt])
  @@map("payout_requests")
}

model DepositInvoice {
  id               String        @id @default(uuid())
  organizationId   String        @map("organization_id")
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  walletAccountId  String        @map("wallet_account_id")
  walletAccount    WalletAccount @relation(fields: [walletAccountId], references: [id], onDelete: Restrict)
  amount           Decimal       @db.Decimal(14, 4)
  currency         String        @default("BRL")
  status           PaymentStatus @default(PENDING)
  paymentMethod    PaymentMethod @default(PIX) @map("payment_method")
  gatewayReference String?       @unique @map("gateway_reference")
  pixQrCode        String?       @map("pix_qr_code")
  pixCopiaECola    String?       @map("pix_copia_e_cola")
  paidAt           DateTime?     @map("paid_at")
  idempotencyKey   String        @unique @map("idempotency_key")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@index([organizationId, createdAt])
  @@map("deposit_invoices")
}

// ==============================================================================
// 5. Auditoria Centralizada
// ==============================================================================

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  userId         String?  @map("user_id")
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  diffBefore     Json?    @map("diff_before")
  diffAfter      Json?    @map("diff_after")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ==============================================================================
// 6. Motor de Inteligência & ASO (App Store Optimization)
// ==============================================================================

model AsoApp {
  id                String                @id @default(uuid())
  organizationId    String                @map("organization_id")
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appId             String                @map("app_id")
  platform          AppPlatform           @default(ANDROID)
  title             String
  developer         String
  developerId       String?               @map("developer_id")
  icon              String
  genre             String?
  genreId           String?               @map("genre_id")
  score             Decimal?              @default(0.0) @db.Decimal(3, 2)
  ratings           Int?                  @default(0)
  reviews           Int?                  @default(0)
  minInstalls       BigInt?               @default(0) @map("min_installs")
  isMonitored       Boolean               @default(true) @map("is_monitored")
  isCompetitor      Boolean               @default(false) @map("is_competitor")
  targetAppId       String?               @map("target_app_id")
  country           String                @default("br")
  lang              String                @default("pt-BR")
  metadata          Json?
  lastScrapedAt     DateTime?             @map("last_scraped_at")
  trackedKeywords   AsoAppKeyword[]
  auditScores       AsoAuditScore[]
  estimates         AsoAppEstimate[]
  aiRecommendations AsoAiRecommendation[]
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  @@unique([organizationId, appId, country, lang])
  @@index([organizationId, isMonitored])
  @@index([appId, country])
  @@map("aso_apps")
}

model AsoKeyword {
  id            String          @id @default(uuid())
  keyword       String
  country       String          @default("br")
  lang          String          @default("pt-BR")
  searchVolume  Int?            @default(0) @map("search_volume")
  difficulty    Int?            @default(0)
  relevance     Int?            @default(0)
  lastTrackedAt DateTime?       @map("last_tracked_at")
  appKeywords   AsoAppKeyword[]
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@unique([keyword, country, lang])
  @@index([keyword])
  @@index([country, lang])
  @@map("aso_keywords")
}

model AsoAppKeyword {
  id             String                     @id @default(uuid())
  asoAppId       String                     @map("aso_app_id")
  asoApp         AsoApp                     @relation(fields: [asoAppId], references: [id], onDelete: Cascade)
  keywordId      String                     @map("keyword_id")
  keyword        AsoKeyword                 @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  currentRank    Int?                       @map("current_rank")
  previousRank   Int?                       @map("previous_rank")
  bestRank       Int?                       @map("best_rank")
  tag            String?
  isActive       Boolean                    @default(true) @map("is_active")
  lastTrackedAt  DateTime?                  @map("last_tracked_at")
  rankingHistory AsoKeywordRankingHistory[]
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")

  @@unique([asoAppId, keywordId])
  @@index([asoAppId, currentRank])
  @@index([keywordId])
  @@map("aso_app_keywords")
}

model AsoKeywordRankingHistory {
  id           String        @id @default(uuid())
  appKeywordId String        @map("app_keyword_id")
  appKeyword   AsoAppKeyword @relation(fields: [appKeywordId], references: [id], onDelete: Cascade)
  rank         Int
  recordedAt   DateTime      @default(now()) @map("recorded_at")

  @@index([appKeywordId, recordedAt])
  @@map("aso_keyword_ranking_history")
}

model AsoAuditScore {
  id                    String   @id @default(uuid())
  asoAppId              String   @map("aso_app_id")
  asoApp                AsoApp   @relation(fields: [asoAppId], references: [id], onDelete: Cascade)
  overallScore          Int      @map("overall_score")
  titleScore            Int      @map("title_score")
  shortDescriptionScore Int      @map("short_description_score")
  longDescriptionScore  Int      @map("long_description_score")
  iconScore             Int      @map("icon_score")
  screenshotsScore      Int      @map("screenshots_score")
  ratingsScore          Int      @map("ratings_score")
  recommendations       Json
  auditDate             DateTime @default(now()) @map("audit_date")

  @@index([asoAppId, auditDate])
  @@map("aso_audit_scores")
}

model AsoAppEstimate {
  id                     String       @id @default(uuid())
  organizationId         String       @map("organization_id")
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asoAppId               String       @map("aso_app_id")
  asoApp                 AsoApp       @relation(fields: [asoAppId], references: [id], onDelete: Cascade)
  date                   DateTime     @map("date")
  country                String       @default("br")
  category               String
  categoryRankBasis      Int?         @map("category_rank_basis")
  dailyDownloadsMin      Int          @map("daily_downloads_min")
  dailyDownloadsMedian   Int          @map("daily_downloads_median")
  dailyDownloadsMax      Int          @map("daily_downloads_max")
  monthlyDownloadsMin    Int          @map("monthly_downloads_min")
  monthlyDownloadsMedian Int          @map("monthly_downloads_median")
  monthlyDownloadsMax    Int          @map("monthly_downloads_max")
  dailyRevenueMin        Decimal      @map("daily_revenue_min") @db.Decimal(12, 2)
  dailyRevenueMedian     Decimal      @map("daily_revenue_median") @db.Decimal(12, 2)
  dailyRevenueMax        Decimal      @map("daily_revenue_max") @db.Decimal(12, 2)
  monthlyRevenueMin      Decimal      @map("monthly_revenue_min") @db.Decimal(12, 2)
  monthlyRevenueMedian   Decimal      @map("monthly_revenue_median") @db.Decimal(12, 2)
  monthlyRevenueMax      Decimal      @map("monthly_revenue_max") @db.Decimal(12, 2)
  currency               String       @default("BRL")
  confidenceScore        Decimal      @map("confidence_score") @db.Decimal(5, 2)
  calculationMethod      String       @default("POWER_LAW_PARETO_V1") @map("calculation_method")
  breakdownJson          Json?        @map("breakdown_json")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  @@unique([asoAppId, date, country])
  @@index([organizationId, date])
  @@index([asoAppId, date])
  @@map("aso_app_estimates")
}

model AsoMarketTrend {
  id                   String   @id @default(uuid())
  category             String
  country              String   @default("br")
  date                 DateTime @map("date")
  breakoutAppsJson     Json     @map("breakout_apps_json")
  trendingKeywordsJson Json     @map("trending_keywords_json")
  summaryMetricsJson   Json?    @map("summary_metrics_json")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@unique([category, country, date])
  @@index([category, date])
  @@map("aso_market_trends")
}

model AsoTrendAlert {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       String
  title          String
  message        String
  severity       String       @default("INFO")
  targetAppId    String?      @map("target_app_id")
  metadata       Json?
  isRead         Boolean      @default(false) @map("is_read")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([organizationId, isRead, createdAt])
  @@map("aso_trend_alerts")
}

enum AsoAiRecommendationType {
  TITLE_OPTIMIZATION
  DESCRIPTION_OPTIMIZATION
  KEYWORD_EXPANSION
  CAMPAIGN_STRATEGY
  CREATIVE_COPY
}

enum AsoAiRecommendationStatus {
  ACTIVE
  APPLIED
  DISMISSED
}

model AsoAiRecommendation {
  id              String                    @id @default(uuid())
  organizationId  String                    @map("organization_id")
  organization    Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asoAppId        String?                   @map("aso_app_id")
  asoApp          AsoApp?                   @relation(fields: [asoAppId], references: [id], onDelete: Cascade)
  type            AsoAiRecommendationType   @default(TITLE_OPTIMIZATION)
  status          AsoAiRecommendationStatus @default(ACTIVE)
  category        String?
  targetKeywords  String[]                  @map("target_keywords")
  inputContext    Json                      @map("input_context")
  suggestionsJson Json                      @map("suggestions_json")
  modelUsed       String                    @default("gemini-1.5-flash") @map("model_used")
  appliedAt       DateTime?                 @map("applied_at")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")

  @@index([organizationId, type, status])
  @@index([asoAppId, type])
  @@map("aso_ai_recommendations")
}

// ==============================================================================
// 6. Telemetria e Ciclo de Vida do Aplicativo
// ==============================================================================

model TelemetrySession {
  id                String                 @id @default(uuid())
  sessionId         String                 @unique @map("session_id")
  appId             String                 @map("app_id")
  app               App                    @relation(fields: [appId], references: [id], onDelete: Cascade)
  organizationId    String                 @map("organization_id")
  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  startedAt         DateTime               @default(now()) @map("started_at")
  endedAt           DateTime?              @map("ended_at")
  durationSeconds   Int                    @default(0) @map("duration_seconds")
  lastHeartbeatAt   DateTime?              @map("last_heartbeat_at")
  deviceModel       String?                @map("device_model")
  osVersion         String?                @map("os_version")
  locale            String?
  timezone          String?
  networkType       String?                @map("network_type")
  carrier           String?
  ipAddress         String?                @map("ip_address")
  isEmulator        Boolean                @default(false) @map("is_emulator")
  isRooted          Boolean                @default(false) @map("is_rooted")
  advertisingId     String?                @map("advertising_id")
  isLimitAdTracking Boolean                @default(false) @map("is_limit_ad_tracking")
  events            TelemetryEventRecord[]
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  @@index([appId, startedAt])
  @@index([organizationId, createdAt])
  @@map("telemetry_sessions")
}

model TelemetryEventRecord {
  id             String           @id @default(uuid())
  eventId        String           @unique @map("event_id")
  sessionId      String           @map("session_id")
  session        TelemetrySession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  appId          String           @map("app_id")
  app            App              @relation(fields: [appId], references: [id], onDelete: Cascade)
  organizationId String           @map("organization_id")
  eventType      String           @map("event_type")
  sequenceNumber Int?             @map("sequence_number")
  properties     Json?
  timestamp      DateTime
  nonce          String
  signature      String
  isFraudulent   Boolean          @default(false) @map("is_fraudulent")
  fraudReason    String?          @map("fraud_reason")
  createdAt      DateTime         @default(now()) @map("created_at")

  @@index([appId, eventType, timestamp])
  @@index([sessionId])
  @@index([organizationId, createdAt])
  @@map("telemetry_events")
}

// ==============================================================================
// 9. Detecção de Fraude e Tráfego Inválido (IVT - Invalid Traffic Detection)
// ==============================================================================

enum IvtCategory {
  GIVT_BOT
  GIVT_DATA_CENTER
  GIVT_EMULATOR
  SIVT_CLICK_SPAM
  SIVT_CLICK_INJECTION
  SIVT_AD_STACKING
  SIVT_FAST_CLICK
  SIVT_GEO_MISMATCH
  SIVT_VIEWABILITY_FRAUD
}

enum FraudSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FraudIncidentStatus {
  DETECTED
  INVESTIGATING
  CONFIRMED
  DISMISSED
  RESOLVED
}

model FraudIncident {
  id                String              @id @default(uuid())
  organizationId    String              @map("organization_id")
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appId             String?             @map("app_id")
  app               App?                @relation(fields: [appId], references: [id], onDelete: SetNull)
  campaignId        String?             @map("campaign_id")
  campaign          Campaign?           @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  adUnitId          String?             @map("ad_unit_id")
  category          IvtCategory
  severity          FraudSeverity       @default(MEDIUM)
  status            FraudIncidentStatus @default(DETECTED)
  sourceIp          String?             @map("source_ip")
  deviceFingerprint String?             @map("device_fingerprint")
  evidencePayload   Json                @map("evidence_payload")
  impactAmount      Decimal             @default(0.0) @map("impact_amount") @db.Decimal(10, 4)
  actionTaken       String?             @map("action_taken")
  resolvedAt        DateTime?           @map("resolved_at")
  resolvedBy        String?             @map("resolved_by")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@index([organizationId, status])
  @@index([category, severity])
  @@index([appId, createdAt])
  @@map("fraud_incidents")
}

# ==========================================
# MGP - Ambiente de Homologação / Staging (.env.staging)
# ==========================================

NODE_ENV=staging

# --- Domínios e URLs Staging ---
APP_URL=https://staging-app.mgp.com.br
API_URL=https://staging-api.mgp.com.br
ADSERVER_URL=https://staging-ads.mgp.com.br
ADMIN_URL=https://staging-admin.mgp.com.br
CDN_URL=https://staging-cdn.mgp.com.br

# --- Portas Internas dos Containers ---
PORT_WEB=3000
PORT_ADSERVER=3001
PORT_API=3000
PORT_ADMIN=3000

# --- Banco de Dados PostgreSQL (EasyPanel Internal Network) ---
DATABASE_URL="postgresql://mgp_staging_user:CHANGE_ME_STAGING_PASSWORD@mgp-staging-postgres:5432/mgp_staging_db?schema=public"
POSTGRES_USER=mgp_staging_user
POSTGRES_PASSWORD=CHANGE_ME_STAGING_PASSWORD
POSTGRES_DB=mgp_staging_db

# --- Cache, Pacing e Filas (Redis 7 Internal Network) ---
REDIS_HOST=mgp-staging-redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STAGING_REDIS_PASSWORD
REDIS_URL="redis://:CHANGE_ME_STAGING_REDIS_PASSWORD@mgp-staging-redis:6379"

# --- Analytics de Telemetria (ClickHouse Staging) ---
CLICKHOUSE_HOST=http://mgp-staging-clickhouse:8123
CLICKHOUSE_DB=mgp_staging_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=CHANGE_ME_STAGING_CH_PASSWORD

# --- Object Storage (S3 / MinIO / Cloudflare R2) ---
STORAGE_ENDPOINT=s3.sa-east-1.amazonaws.com
STORAGE_PORT=443
STORAGE_USE_SSL=true
STORAGE_ACCESS_KEY=CHANGE_ME_STAGING_KEY
STORAGE_SECRET_KEY=CHANGE_ME_STAGING_SECRET
STORAGE_BUCKET_CREATIVES=mgp-staging-creatives
STORAGE_BUCKET_PUBLIC=mgp-staging-public

# --- Segurança & Autenticação ---
JWT_ACCESS_SECRET=CHANGE_ME_RANDOMLY_GENERATED_64_CHARS_HEX_STAGING
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET=CHANGE_ME_RANDOMLY_GENERATED_64_CHARS_HEX_STAGING
JWT_REFRESH_EXPIRES_IN="7d"
AD_TOKEN_SIGNING_SECRET=CHANGE_ME_ADSERVER_HMAC_SECRET_STAGING

# --- Taxa e Limites (Rate Limiting) ---
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
AD_REQUEST_RATE_LIMIT=300

# --- Logs & Observabilidade ---
LOG_LEVEL=info


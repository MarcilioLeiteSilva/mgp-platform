# ==========================================
# MGP - Ambiente de Desenvolvimento Local (.env.development)
# ==========================================

NODE_ENV=development

# --- Domínios e URLs Locais ---
APP_URL=http://localhost:3000
API_URL=http://localhost:3002
ADSERVER_URL=http://localhost:3001
ADMIN_URL=http://localhost:3003
CDN_URL=http://localhost:9000/mgp-public

# --- Portas dos Serviços ---
PORT_WEB=3000
PORT_ADSERVER=3001
PORT_API=3002
PORT_ADMIN=3003

# --- Banco de Dados PostgreSQL (Local via Docker Compose) ---
DATABASE_URL="postgresql://mgp_user:mgp_secret_password@localhost:5432/mgp_db?schema=public"
POSTGRES_USER=mgp_user
POSTGRES_PASSWORD=mgp_secret_password
POSTGRES_DB=mgp_db

# --- Cache, Pacing e Filas (Redis 7) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=mgp_redis_password
REDIS_URL="redis://:mgp_redis_password@localhost:6379"

# --- Analytics de Telemetria (ClickHouse) ---
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_DB=mgp_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=mgp_clickhouse_password

# --- Object Storage (MinIO Local) ---
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=mgp_minio_admin
STORAGE_SECRET_KEY=mgp_minio_password123
STORAGE_BUCKET_CREATIVES=mgp-creatives
STORAGE_BUCKET_PUBLIC=mgp-public

# --- Segurança & Autenticação ---
JWT_ACCESS_SECRET="dev_super_secret_access_key_min_32_characters_long_12345"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="dev_super_secret_refresh_key_min_32_characters_long_12345"
JWT_REFRESH_EXPIRES_IN="7d"
AD_TOKEN_SIGNING_SECRET="dev_ad_server_hmac_secret_key_987654321_token"

# --- Taxa e Limites (Rate Limiting) ---
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
AD_REQUEST_RATE_LIMIT=300

# --- Logs & Observabilidade ---
LOG_LEVEL=debug


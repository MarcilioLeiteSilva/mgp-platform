# ==========================================
# MGP - Ambiente de Produção Oficial (.env.production)
# ==========================================

NODE_ENV=production

# --- Domínios e URLs Oficiais de Produção ---
APP_URL=https://app.mgp.com.br
API_URL=https://api.mgp.com.br
ADSERVER_URL=https://ads.mgp.com.br
ADMIN_URL=https://admin.mgp.com.br
CDN_URL=https://cdn.mgp.com.br
DOCS_URL=https://docs.mgp.com.br
STATUS_URL=https://status.mgp.com.br

# --- Portas Internas dos Containers ---
PORT_WEB=3000
PORT_ADSERVER=3001
PORT_API=3000
PORT_ADMIN=3000

# --- Banco de Dados PostgreSQL (EasyPanel Internal Isolated Network) ---
# Formato: postgresql://USER:PASSWORD@mgp-postgres:5432/DB?schema=public&sslmode=prefer
DATABASE_URL="postgresql://mgp_prod_user:GENERATE_STRONG_PROD_PASSWORD_HERE@mgp-postgres:5432/mgp_prod_db?schema=public&connection_limit=50"
POSTGRES_USER=mgp_prod_user
POSTGRES_PASSWORD=GENERATE_STRONG_PROD_PASSWORD_HERE
POSTGRES_DB=mgp_prod_db

# --- Cache, Pacing e Filas (Redis 7) ---
REDIS_HOST=mgp-redis
REDIS_PORT=6379
REDIS_PASSWORD=GENERATE_STRONG_REDIS_AUTH_PROD
REDIS_URL="redis://:GENERATE_STRONG_REDIS_AUTH_PROD@mgp-redis:6379"

# --- Analytics de Telemetria (ClickHouse Production) ---
CLICKHOUSE_HOST=http://mgp-clickhouse:8123
CLICKHOUSE_DB=mgp_analytics_prod
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=GENERATE_STRONG_CLICKHOUSE_PASSWORD

# --- Object Storage (Cloudflare R2 / AWS S3) ---
STORAGE_ENDPOINT=s3.sa-east-1.amazonaws.com
STORAGE_PORT=443
STORAGE_USE_SSL=true
STORAGE_ACCESS_KEY=PROD_S3_ACCESS_KEY_ID
STORAGE_SECRET_KEY=PROD_S3_SECRET_ACCESS_KEY
STORAGE_BUCKET_CREATIVES=mgp-prod-creatives
STORAGE_BUCKET_PUBLIC=mgp-prod-public

# --- Segurança & Autenticação (Alta Entropia 256 bits) ---
JWT_ACCESS_SECRET=GENERATE_64_CHAR_HEX_KEY_OPENSSL_RAND_HEX_32
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET=GENERATE_64_CHAR_HEX_KEY_OPENSSL_RAND_HEX_32
JWT_REFRESH_EXPIRES_IN="7d"
AD_TOKEN_SIGNING_SECRET=GENERATE_64_CHAR_HEX_KEY_FOR_ADSERVER_HMAC

# --- Taxa e Limites (Rate Limiting de Produção) ---
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
AD_REQUEST_RATE_LIMIT=1000

# --- Logs & Observabilidade ---
LOG_LEVEL=info

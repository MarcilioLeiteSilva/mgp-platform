# ==========================================
# Multi-stage Dockerfile para apps/admin (Next.js Backoffice)
# ==========================================

FROM node:20-alpine AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.30.2 --activate
RUN apk add --no-cache libc6-compat

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json .npmrc* ./
COPY packages/ ./packages/
COPY apps/admin/ ./apps/admin/

RUN pnpm install --frozen-lockfile

ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

RUN pnpm --filter @mgp/shared build
RUN pnpm --filter @mgp/config build
RUN pnpm --filter @mgp/contracts build
RUN pnpm --filter @mgp/admin build

# ------------------------------------------
# Runner de Produção (Next.js Standalone Monorepo)
# ------------------------------------------
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 adminjs

COPY --from=builder /app/apps/admin/public ./apps/admin/public
COPY --from=builder --chown=adminjs:nodejs /app/apps/admin/.next/standalone ./
COPY --from=builder --chown=adminjs:nodejs /app/apps/admin/.next/static ./apps/admin/.next/static

USER adminjs

EXPOSE 3000

CMD ["node", "apps/admin/server.js"]

# ==========================================
# Multi-stage Dockerfile para apps/workers (BullMQ)
# ==========================================

FROM node:20-alpine AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.1.0 --activate
RUN apk add --no-cache libc6-compat

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages/ ./packages/
COPY apps/workers/ ./apps/workers/

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @mgp/database prisma generate
RUN pnpm --filter @mgp/workers build
RUN pnpm prune --prod

# ------------------------------------------
# Runner de Produção
# ------------------------------------------
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 worker

COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/database/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/packages/database/node_modules/@prisma ./node_modules/@prisma
COPY --from=builder /app/apps/workers/dist ./apps/workers/dist
COPY --from=builder /app/apps/workers/package.json ./apps/workers/package.json

USER worker

CMD ["node", "apps/workers/dist/main.js"]

